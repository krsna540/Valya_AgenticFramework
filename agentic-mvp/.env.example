# Copy to .env and adjust as needed. docker-compose reads this automatically.
#
# Every variable here has a default baked into docker-compose.yml, so the
# stack comes up correctly with no .env at all. This file shows what is
# tunable; it is not required.

# --- Postgres ---------------------------------------------------------------
# One instance backs three schemas: the app's own tables (Alembic), LangGraph's
# checkpoints, and Temporal's two databases (created by auto-setup).
POSTGRES_USER=agentic
POSTGRES_PASSWORD=agentic
POSTGRES_DB=agentic
POSTGRES_PORT=5432

# --- Auth -------------------------------------------------------------------
# RS256 by default — generate a pair with `python backend/scripts/generate_jwt_keypair.py`
# and paste both PEM blocks below as single-line, \n-escaped strings. Leave
# both blank to fall back to the HS256 secret (dev convenience only).
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_SECRET=change-me-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Host ports -------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000
OPA_PORT=8181
# OPA Control Plane's management API. Published on 127.0.0.1 only — it can
# rewrite the bundle that authorizes every request in this app and runs
# unauthenticated here. See docs/AUTHORIZATION.md §6.3 before changing that.
OPA_CONTROL_PLANE_PORT=8282
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8080
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# 5001, not 5000: macOS AirPlay Receiver squats on 5000. Container port is
# unchanged, so in-network URLs stay http://mlflow:5000.
MLFLOW_PORT=5001

# --- Redis / MinIO ------------------------------------------------------------
MINIO_ACCESS_KEY=valya
MINIO_SECRET_KEY=valya-dev-secret
MINIO_SKILLS_BUCKET=skills

# --- Agent runtime (app/agents/) --------------------------------------------
# Deployment-level settings for the Planner -> Executor -> Critic graph.
# Per-agent budgets (revisions, replans, timeouts, whether the critic runs,
# whether tools may actually be invoked) live per row in agents.runtime_config,
# not here — see app/agents/config.py.

# stub    = deterministic offline provider. The default, so a fresh checkout
#           runs the whole graph with no credentials.
# direct  = real calls straight to Anthropic/OpenAI over httpx, no gateway.
#           Set the ANTHROPIC_/OPENAI_ keys below to use this.
# gateway = MLflow AI Gateway — requires its one-time UI setup first (see
#           docker-compose.yml's `mlflow` service comment).
AGENT_LLM_PROVIDER=stub
AGENT_LLM_GATEWAY_URL=http://mlflow:5000/gateway/mlflow
AGENT_LLM_API_KEY=

# Real LLM calls (AGENT_LLM_PROVIDER=direct) — Planner/Critic route to
# Anthropic, Executor routes to OpenAI. Leave a key blank to route every
# role to whichever provider does have a key configured.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-4o-mini
AGENT_LLM_ROUTE_PLANNER=claude-strong
AGENT_LLM_ROUTE_EXECUTOR=openai-fast
AGENT_LLM_ROUTE_CRITIC=claude-strong

# memory   = per-process LangGraph checkpoints, lost on restart.
# postgres = resumable runs and durable human-in-the-loop interrupts.
#            Degrades to memory with a warning if it can't be provisioned.
AGENT_CHECKPOINTER=postgres

# Temporal is part of the stack, so this defaults on. Interactive chat still
# runs in-process regardless (token streaming only exists on that path); this
# is what makes the durable path available to everything else.
TEMPORAL_ENABLED=true
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=valya-agents

# --- Frontend ---------------------------------------------------------------
# Read by the frontend build (Vite bakes this in at build time, so a change
# needs `docker compose up --build frontend`, not just a restart).
VITE_API_BASE_URL=http://localhost:8000
