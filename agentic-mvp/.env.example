# Copy to .env and adjust as needed. docker-compose reads this automatically.

POSTGRES_USER=agentic
POSTGRES_PASSWORD=agentic
POSTGRES_DB=agentic
POSTGRES_PORT=5432

JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

BACKEND_PORT=8000
FRONTEND_PORT=3000
OPA_PORT=8181
OPA_CONTROL_PLANE_PORT=8282

# Read by the frontend build (Vite bakes this in at build time)
VITE_API_BASE_URL=http://localhost:8000
