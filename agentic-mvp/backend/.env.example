ENVIRONMENT=development

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=agentic
POSTGRES_PASSWORD=agentic
POSTGRES_DB=agentic

JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

UPLOAD_DIR=data/uploads
MAX_UPLOAD_BYTES=26214400

SKILL_PACKAGES_DIR=data/skill_packages
MAX_SKILL_PACKAGE_ZIP_BYTES=10485760
MAX_SKILL_PACKAGE_EXTRACTED_BYTES=41943040
MAX_SKILL_PACKAGE_FILES=500

# --- Agent runtime (app/agents/) --------------------------------------------
# Deployment-level settings for the Planner -> Executor -> Critic graph.
# Per-agent budgets (revisions, replans, timeouts, whether the critic runs,
# whether tools may actually be invoked) are NOT here — they live per row in
# agents.runtime_config and are validated by app/agents/config.py.

# stub    = deterministic offline provider; no credentials needed, and the
#           full graph, revision loop and persistence all still exercise.
# gateway = MLflow AI Gateway (OpenAI-compatible REST over httpx).
AGENT_LLM_PROVIDER=stub
AGENT_LLM_GATEWAY_URL=
AGENT_LLM_API_KEY=
AGENT_LLM_TIMEOUT_S=60

# memory   = per-process LangGraph checkpoints, lost on restart.
# postgres = resumable runs and durable human-in-the-loop interrupts.
#            Degrades to memory with a warning if it can't be provisioned.
AGENT_CHECKPOINTER=memory

# Temporal durable envelope. Off => runs execute in-process, which is the
# right choice for interactive chat (token streaming only exists on that
# path). On => each run is a durable workflow that survives a restart.
# Requires `docker compose --profile temporal up`.
TEMPORAL_ENABLED=false
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=valya-agents
TEMPORAL_WORKFLOW_TIMEOUT_S=1800
